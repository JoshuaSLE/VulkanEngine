CompileFlags:
  Add: [-std=c++23, -Wall, -Wextra, -Wpedantic]
  CompilationDatabase: build/debug/

Index:
  Background: Build

Diagnostics:
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - modernize-*
    Remove:
      - modernize-use-trailing-return-type
      - modernize-use-nodiscard

Hover:
  ShowAKA: Yes
